PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

# Generate each with: openssl rand -hex 32
CSRF_SECRET=
ACCESS_SECRET=

# Authenticated session lifetime in ms (default: 7 days)
SESSION_TTL_MS=604800000
# bcrypt work factor (default: 12). Keep >= 10 in production; tests use 4
BCRYPT_COST=12
